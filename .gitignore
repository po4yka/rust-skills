# Agent and tooling state. .claude/settings.json and .codex/hooks.json are
# shared on purpose; personal settings and worktrees are not.
.omc/
.claude/settings.local.json
.claude/worktrees/

# macOS
.DS_Store

# Editor scratch
.idea/
.vscode/
.zed/
*.swp

# Python bytecode from scripts/ and checks/
__pycache__/

# Evaluation results: they need a key, so they are recorded in research/, not here
evals/routing/routing-*.json
evals/plugin/results/
evals/outcome/results/
eval-results.json
/checks/sandbox-eval/results/
/sandbox-results.json

# Build output of the outcome-eval fixture crates
evals/outcome/*/files/target/

# Complete compiler copy for the isolated outcome evaluation; never distributed.
/checks/eval-tools/
